<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ВетКлініка 🐾</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body, html { height: 100%; margin: 0; font-family: 'Segoe UI', sans-serif; overflow: hidden; }
        
        .hero {
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), 
                        url('https://images.unsplash.com/photo-1544568100-847a948585b9?q=80&w=1974&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }

        .brand-title {
            font-size: 5.5rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -2px;
            margin-bottom: 40px; /* Збільшив відступ до кнопок */
            text-shadow: 0 10px 40px rgba(0,0,0,0.6);
            animation: fadeInUp 0.8s ease-out;
        }

        .brand-title span {
            color: #2ec4b6;
        }

        .btn-hero { 
            padding: 16px 45px; 
            border-radius: 50px; 
            font-weight: 800; 
            margin: 10px; 
            text-transform: uppercase; 
            transition: 0.4s; 
            text-decoration: none; 
            display: inline-block; 
            letter-spacing: 1px;
        }

    
        .btn-reg { 
            background-color: #ff9f1c; 
            color: white; 
            border: none; 
            box-shadow: 0 10px 25px rgba(255, 159, 28, 0.4);
        }
        .btn-reg:hover { 
            background-color: #f39200; 
            transform: translateY(-5px); 
            box-shadow: 0 15px 35px rgba(255, 159, 28, 0.5);
            color: white;
        }

        .btn-log { 
            background-color: transparent; 
            color: white; 
            border: 2.5px solid white; 
        }
        .btn-log:hover { 
            background-color: white; 
            color: #011627; 
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(255, 255, 255, 0.2);
        }

        .button-container {
            animation: fadeInUp 1s ease-out;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

<div class="hero">
    <div class="container">
        <h1 class="brand-title">Вет<span>Клініка</span></h1>
        
        <div class="d-flex justify-content-center flex-wrap button-container">
            <a href="/likar/register/new" class="btn btn-hero btn-reg">
                <i class="bi bi-person-plus-fill me-2"></i> Реєстрація
            </a>
            
            <a href="/likar/login" class="btn btn-hero btn-log">
                <i class="bi bi-box-arrow-in-right me-2"></i> Увійти
            </a>
        </div>
    </div>
</div>

</body>
</html>