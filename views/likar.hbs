<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ВетКлініка 🐾</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', sans-serif; }
        .navbar { background-color: #2ec4b6 !important; } /* Бірюзовий колір для ветеринарки */
        .card { border: none; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .table thead { background-color: #2ec4b6; color: white; }
        .btn-add { background-color: #ff9f1c; color: white; border-radius: 30px; padding: 10px 25px; }
        .btn-add:hover { background-color: #e71d36; color: white; }
    </style>
</head>
<body>

<nav class="navbar navbar-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="/likar">
            <i class="bi bi-patch-check-fill"></i> ВетКлініка "Щасливі лапки"
        </a>
    </div>
</nav>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-secondary">Графік прийому</h2>
        <a href="/likar/create" class="btn btn-add shadow-sm">
            <i class="bi bi-plus-lg"></i> Новий пацієнт
        </a>
    </div>

    <div class="card p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Час (30 хв)</th>
                        <th>Власник</th>
                        <th>Тварина 🐶</th>
                        <th>Контакти</th>
                        <th class="text-center">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each appointments}}
                    <tr>
                        <td><span class="badge bg-light text-dark">{{this.appointment_date}}</span></td>
                        <td><strong>{{this.start_time}} - {{this.end_time}}</strong></td>
                        <td>{{this.owner_name}}</td>
                        <td><i class="bi bi-heart-fill text-danger"></i> {{this.pet_name}}</td>
                        <td><a href="tel:{{this.phone}}" class="text-decoration-none">{{this.phone}}</a></td>
                        <td class="text-center">
                            <a href="/likar/delete/{{this.id}}" class="btn btn-outline-danger btn-sm border-0">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

</body>
</html>