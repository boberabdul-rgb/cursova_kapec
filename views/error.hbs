<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Помилка 🐾</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f8fafc; height: 100vh; display: flex; align-items: center; justify-content: center; font-family: sans-serif; }
        .error-card { background: white; padding: 50px; border-radius: 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.05); text-align: center; max-width: 500px; }
        .btn-home { background: #2ec4b6; color: white; border-radius: 12px; padding: 12px 30px; text-decoration: none; font-weight: bold; display: inline-block; margin-top: 20px; }
    </style>
</head>
<body>
    <div class="error-card">
        <h1 class="display-1 fw-bold text-muted">!</h1>
        <h2 class="fw-bold mb-3">Сталася помилка</h2>
        <p class="text-muted">{{message}}</p>
        <a href="/likar" class="btn-home shadow-sm">Повернутися до таблиці</a>
    </div>
</body>
</html>