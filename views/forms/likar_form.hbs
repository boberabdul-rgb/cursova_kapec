<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #2ec4b6 0%, #011627 100%); min-height: 100vh; display: flex; align-items: center; }
        .form-card { background: white; border-radius: 20px; padding: 40px; width: 100%; max-width: 500px; box-shadow: 0 15px 35px rgba(0,0,0,0.2); }
        .btn-save { background: #2ec4b6; color: white; width: 100%; border-radius: 10px; padding: 12px; font-weight: bold; border: none; }
    </style>
</head>
<body>

<div class="container d-flex justify-content-center">
    <div class="form-card">
        <h3 class="text-center mb-4">📝 Запис пацієнта</h3>
        <form action="/likar/create" method="POST">
            <div class="mb-3">
                <label class="form-label">Ім'я власника</label>
                <input type="text" name="owner_name" class="form-control" placeholder="Наприклад, Іван" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Кличка тварини</label>
                <input type="text" name="pet_name" class="form-control" placeholder="Наприклад, Барон" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Номер телефону</label>
                <input type="tel" name="phone" class="form-control" placeholder="+380..." required>
            </div>
            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label">Дата</label>
                    <input type="date" name="date" class="form-control" required>
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label">Час</label>
                    <input type="time" name="start_time" class="form-control" step="1800" required>
                </div>
            </div>
            <button type="submit" class="btn btn-save mb-2">Забронювати час</button>
            <a href="/likar" class="btn btn-light w-100">Повернутися</a>
        </form>
    </div>
</div>

</body>
</html>