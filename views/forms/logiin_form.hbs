<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root { --primary-dark: #011627; --accent-cyan: #2ec4b6; }
        
        body { 
            background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--primary-dark) 100%); 
            min-height: 100vh; 
            display: flex; 
            align-items: center; 
            font-family: 'Segoe UI', sans-serif; 
        }

        .login-card { 
            background: white; 
            border-radius: 30px; 
            padding: 50px; 
            width: 100%; 
            max-width: 450px; 
            box-shadow: 0 25px 50px rgba(0,0,0,0.3); 
            border: none;
            transition: transform 0.3s ease;
        }

        .login-card:hover { transform: translateY(-5px); }

        .icon-circle {
            width: 80px;
            height: 80px;
            background: rgba(46, 196, 182, 0.1);
            color: var(--accent-cyan);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 2.5rem;
        }

        .form-label { font-weight: 600; color: #475569; }

        .input-group {
            background-color: #f8fafc;
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            transition: 0.3s;
        }

        .input-group:focus-within {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 0 4px rgba(46, 196, 182, 0.1);
        }

        .input-group-text {
            background: transparent;
            border: none;
            color: #94a3b8;
            padding-left: 20px;
        }

        .form-control {
            background: transparent;
            border: none;
            padding: 15px;
            font-size: 1rem;
        }

        .form-control:focus { box-shadow: none; background: transparent; }

        .btn-login { 
            background: var(--accent-cyan); 
            color: white; 
            width: 100%; 
            border-radius: 15px; 
            padding: 15px; 
            font-weight: 700; 
            border: none; 
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: 0.3s;
            margin-top: 20px;
        }

        .btn-login:hover { 
            background: #26a69a; 
            box-shadow: 0 10px 20px rgba(46, 196, 182, 0.3);
        }

        .link-footer { color: #64748b; text-decoration: none; font-size: 0.9rem; transition: 0.3s; }
        .link-footer:hover { color: var(--accent-cyan); }
    </style>
</head>
<body>

<div class="container d-flex justify-content-center">
    <div class="login-card text-center">
        <div class="icon-circle">
            <i class="bi bi-shield-lock"></i>
        </div>
        
        <h2 class="fw-bold text-dark mb-1">Вітаємо знову!</h2>
        <p class="text-muted mb-4">Увійдіть у свій кабінет</p>

        <form action="/likar/login" method="POST">
            <div class="mb-3 text-start">
                <label class="form-label ms-1">Номер телефону</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                    <input type="tel" name="phone" class="form-control" placeholder="+380..." required>
                </div>
            </div>

            <div class="mb-4 text-start">
                <label class="form-label ms-1">Пароль</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>
            </div>

            <button type="submit" class="btn btn-login shadow">Увійти в систему</button>
            
            <div class="mt-4">
                <a href="/likar/register/new" class="link-footer">Немає акаунту? <strong class="text-dark">Створити зараз</strong></a>
            </div>
            <div class="mt-2">
                <a href="/" class="link-footer small"><i class="bi bi-arrow-left"></i> На головну</a>
            </div>
        </form>
    </div>
</div>

</body>
</html>