<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root { --primary-dark: #011627; --accent-cyan: #34d1bf; }
        
        body { 
            background: linear-gradient(135deg, #22a699 0%, var(--primary-dark) 100%); 
            min-height: 100vh; 
            display: flex; 
            align-items: center; 
            font-family: 'Segoe UI', sans-serif;
            padding: 40px 0;
        }

        .register-card { 
            background: white; 
            border-radius: 40px; 
            padding: 50px; 
            width: 100%; 
            max-width: 500px; 
            box-shadow: 0 25px 60px rgba(0,0,0,0.4); 
            border: none;
        }

        .icon-circle {
            width: 85px;
            height: 85px;
            background: rgba(52, 209, 191, 0.1);
            color: var(--accent-cyan);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            font-size: 2.8rem;
        }

        .form-label { font-weight: 600; color: #475569; font-size: 0.9rem; margin-bottom: 6px; }

        .input-group {
            background-color: #f1f5f9;
            border-radius: 16px;
            overflow: hidden;
            border: 2px solid transparent;
            transition: 0.3s;
            margin-bottom: 15px;
        }

        .input-group:focus-within {
            border-color: var(--accent-cyan);
            background-color: white;
            box-shadow: 0 0 0 5px rgba(52, 209, 191, 0.15);
        }

        .input-group-text {
            background: transparent;
            border: none;
            color: #94a3b8;
            padding-left: 18px;
        }

        .form-control {
            background: transparent;
            border: none;
            padding: 12px;
            font-size: 1rem;
            color: #1e293b;
        }

        .form-control:focus { box-shadow: none; background: transparent; }

        .btn-register { 
            background: var(--accent-cyan); 
            color: white; 
            width: 100%; 
            border-radius: 16px; 
            padding: 16px; 
            font-weight: 800; 
            border: none; 
            text-transform: uppercase;
            letter-spacing: 1.5px;
            transition: 0.3s;
            margin-top: 20px;
            box-shadow: 0 10px 20px rgba(52, 209, 191, 0.3);
        }

        .btn-register:hover { 
            background: #2bc1b0;
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(52, 209, 191, 0.4);
        }

        .link-footer { color: #64748b; text-decoration: none; font-size: 0.95rem; transition: 0.2s; }
        .link-footer:hover { color: var(--primary-dark); font-weight: 600; }
        
        .footer-divider {
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid #f1f5f9;
        }
    </style>
</head>
<body>

<div class="container d-flex justify-content-center">
    <div class="register-card text-center">
        <div class="icon-circle">
            <i class="bi bi-person-plus"></i>
        </div>
        
        <h2 class="fw-bold text-dark mb-4">Реєстрація</h2>

        <form action="/likar/register/new" method="POST">
            <div class="text-start">
                <label class="form-label ms-1">Ім'я власника</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" name="first_name" class="form-control" placeholder="" required>
                </div>

                <label class="form-label ms-1">Прізвище власника</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                    <input type="text" name="last_name" class="form-control" placeholder="" required>
                </div>

                <label class="form-label ms-1">Назва тварини</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-paw"></i></span>
                    <input type="text" name="pet_name" class="form-control" placeholder="" required>
                </div>

                <label class="form-label ms-1">Номер телефону</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                    <input type="tel" name="phone" class="form-control" placeholder="+380..." required>
                </div>

                <label class="form-label ms-1">Пароль</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>
            </div>

            <button type="submit" class="btn btn-register">Зареєструватись</button>
            
            <div class="footer-divider">
                <a href="/likar/login" class="link-footer">Вже з нами? <strong class="text-dark">Увійти</strong></a>
                <div class="mt-2">
                    <a href="/" class="link-footer small"><i class="bi bi-arrow-left"></i> На головну</a>
                </div>
            </div>
        </form>
    </div>
</div>

</body>
</html>